# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - enables web search
PERPLEXITY_API_KEY=pplx-your-key-here

# PostgreSQL connection string for Supabase
# Find in: Supabase Dashboard → Settings → Database → Connection string → URI
# IMPORTANT: This must start with postgresql:// NOT https://
# The SUPABASE_URL from @supabase/supabase-js (https://...) will NOT work here.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Port (default: 5000)
PORT=5000
