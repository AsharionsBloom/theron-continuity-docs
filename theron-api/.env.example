# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - enables web search
PERPLEXITY_API_KEY=pplx-your-key-here

# Supabase - use the direct PostgreSQL connection string (NOT the Supabase URL)
# Find in: Supabase Dashboard > Settings > Database > Connection string > URI
SUPABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Port (default: 5000)
PORT=5000
