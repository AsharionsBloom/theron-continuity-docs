{
  "name": "theron-memory-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Theron's memory system with semantic search",
  "type": "module",
  "bin": {
    "theron-memory-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
